local function SetAnchor(Value)
    local Character = Player.Character
    if not Character then return end

    local Root = Character:FindFirstChild("HumanoidRootPart")
    if Root then
        Root.Anchored = Value
    end
end

local function ToggleFreecam()
    Active = not Active

    if Active then
        Status.Text = "TRẠNG THÁI: BẬT"
        Status.BackgroundColor3 = Color3.fromRGB(16, 128, 55)

        SavedType = Camera.CameraType
        SavedSubject = Camera.CameraSubject
        CamPosition = Camera.CFrame.Position

        local X, Y = Camera.CFrame:ToOrientation()
        RotationX = Y
        RotationY = X

        Camera.CameraType = Enum.CameraType.Scriptable
        SetAnchor(true)
    else
        Status.Text = "TRẠNG THÁI: TẮT"
        Status.BackgroundColor3 = Color3.fromRGB(30, 30, 30)

        Camera.CameraType = SavedType or Enum.CameraType.Custom
        Camera.CameraSubject = SavedSubject

        SetAnchor(false)
    end
end

Status.MouseButton1Click:Connect(ToggleFreecam)

SpeedButton.MouseButton1Click:Connect(function()
    SpeedIndex += 1

    if SpeedIndex > #Speeds then
        SpeedIndex = 1
    end

    Speed = Speeds[SpeedIndex]
    SpeedButton.Text = "TỐC ĐỘ: " .. Speed .. "x"
end)

FOVSlider.MouseButton1Click:Connect(function()
    local MousePosition = UIS:GetMouseLocation()
    local X = MousePosition.X - FOVSlider.AbsolutePosition.X
    local Percent = math.clamp(X / FOVSlider.AbsoluteSize.X, 0, 1)

    FOV = math.floor(30 + Percent * 90)

    FOVProgress.Size = UDim2.new(Percent, 0, 1, 0)
    FOVLabel.Text = "FOV: " .. FOV
    Camera.FieldOfView = FOV
end)

Teleport.MouseButton1Click:Connect(function()
    local Character = Player.Character
    if not Character then return end

    local Root = Character:FindFirstChild("HumanoidRootPart")
    if not Root then return end

    local WasAnchored = Root.Anchored

    Root.Anchored = false
    Root.CFrame = CFrame.new(Camera.CFrame.Position)

    if Active or WasAnchored then
        Root.Anchored = true
    end
end)

local Hidden = false

local function ToggleMenu()
    Hidden = not Hidden

    Main.Size = Hidden
        and UDim2.fromOffset(180, 40)
        or UDim2.fromOffset(180, 235)

    Hide.Text = Hidden and "HIỆN" or "ẨN"

    FOVLabel.Visible = not Hidden
    FOVSlider.Visible = not Hidden
    Status.Visible = not Hidden
    SpeedButton.Visible = not Hidden
    Teleport.Visible = not Hidden
end

Hide.MouseButton1Click:Connect(ToggleMenu)
Dot.MouseButton1Click:Connect(ToggleMenu)

UIS.InputChanged:Connect(function(Input)
    if not Active then return end

    if Input.UserInputType == Enum.UserInputType.Touch
        or Input.UserInputType == Enum.UserInputType.MouseMovement then

        local Sensitivity = 0.005

        RotationX -= Input.Delta.X * Sensitivity
        RotationY -= Input.Delta.Y * Sensitivity

        RotationY = math.clamp(
            RotationY,
            -math.rad(80),
            math.rad(80)
        )
    end
end)

RunService.RenderStepped:Connect(function(DeltaTime)
    if not Active then return end

    Camera.FieldOfView = FOV

    local Rotation =
        CFrame.Angles(0, RotationX, 0) *
        CFrame.Angles(RotationY, 0, 0)

    Camera.CFrame = CFrame.new(CamPosition) * Rotation

    local Character = Player.Character
    local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")

    if Humanoid then
        local Move = Humanoid.MoveDirection

        if Move.Magnitude > 0 then
            local Forward = Camera.CFrame.LookVector
            local Right = Camera.CFrame.RightVector

            local FlatForward = Vector3.new(Forward.X, 0, Forward.Z)
            local FlatRight = Vector3.new(Right.X, 0, Right.Z)

            if FlatForward.Magnitude > 0 then
                FlatForward = FlatForward.Unit
            end

            if FlatRight.Magnitude > 0 then
                FlatRight = FlatRight.Unit
            end

            local ForwardInput = Move:Dot(FlatForward)
            local SideInput = Move:Dot(FlatRight)

            local FlyDirection =
                FlatForward * ForwardInput +
                FlatRight * SideInput

            if FlyDirection.Magnitude > 0 then
                CamPosition +=
                    FlyDirection.Unit *
                    Speed *
                    60 *
                    DeltaTime
            end
        end
    end

    Camera.CFrame = CFrame.new(CamPosition) * Rotation
end)
