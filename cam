local TouchLookInput = nil

UIS.InputBegan:Connect(function(Input)
    if not Active then
        return
    end

    if Input.UserInputType == Enum.UserInputType.Touch then
        local Position = Input.Position
        local CameraViewport = Camera.ViewportSize

        if Position.X > CameraViewport.X * 0.35 then
            TouchLookInput = Input
        end
    end
end)

UIS.InputChanged:Connect(function(Input)
    if not Active then
        return
    end

    if Input.UserInputType == Enum.UserInputType.MouseMovement then
        local Sensitivity = 0.005

        RotationX -= Input.Delta.X * Sensitivity
        RotationY -= Input.Delta.Y * Sensitivity

        RotationY = math.clamp(
            RotationY,
            -math.rad(80),
            math.rad(80)
        )
    elseif Input.UserInputType == Enum.UserInputType.Touch
        and TouchLookInput == Input then

        local Sensitivity = 0.005

        RotationX -= Input.Delta.X * Sensitivity
        RotationY -= Input.Delta.Y * Sensitivity

        RotationY = math.clamp(
            RotationY,
            -math.rad(80),
            math.rad(80)
        )
    end
end)

UIS.InputEnded:Connect(function(Input)
    if Input == TouchLookInput then
        TouchLookInput = nil
    end
end)

RunService.RenderStepped:Connect(function(DeltaTime)
    if not Active then
        return
    end

    Camera.FieldOfView = FOV

    local Rotation =
        CFrame.Angles(0, RotationX, 0) *
        CFrame.Angles(RotationY, 0, 0)

    local Character = Player.Character
    local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")

    if Humanoid then
        local Move = Humanoid.MoveDirection

        if Move.Magnitude > 0 then
            local Forward = Camera.CFrame.LookVector
            local Right = Camera.CFrame.RightVector

            local FlatForward = Vector3.new(
                Forward.X,
                0,
                Forward.Z
            )

            local FlatRight = Vector3.new(
                Right.X,
                0,
                Right.Z
            )

            if FlatForward.Magnitude > 0 then
                FlatForward = FlatForward.Unit
            end

            if FlatRight.Magnitude > 0 then
                FlatRight = FlatRight.Unit
            end

            local ForwardInput = Move:Dot(FlatForward)
            local SideInput = Move:Dot(FlatRight)

            local FlyDirection =
                FlatForward * ForwardInput +
                FlatRight * SideInput

            if FlyDirection.Magnitude > 0 then
                CamPosition +=
                    FlyDirection.Unit *
                    Speed *
                    60 *
                    DeltaTime
            end
        end
    end

    if Up then
        CamPosition += Vector3.new(
            0,
            Speed * 60 * DeltaTime,
            0
        )
    end

    if Down then
        CamPosition -= Vector3.new(
            0,
            Speed * 60 * DeltaTime,
            0
        )
    end

    Camera.CFrame =
        CFrame.new(CamPosition) *
        Rotation
end)

