local function GetRoot()
    local Character = Player.Character
    if not Character then return nil end
    return Character:FindFirstChild("HumanoidRootPart")
end

local function SetAnchor(Value)
    local Root = GetRoot()
    if Root then
        Root.Anchored = Value
    end
end

local function SetJumpVisible(Value)
    local PlayerGui = Player:FindFirstChildOfClass("PlayerGui")
    if not PlayerGui then return end

    local TouchGui = PlayerGui:FindFirstChild("TouchGui")
    if not TouchGui then return end

    local TouchControlFrame = TouchGui:FindFirstChild("TouchControlFrame")
    if not TouchControlFrame then return end

    local JumpButton = TouchControlFrame:FindFirstChild("JumpButton")
    if JumpButton then
        JumpButton.Visible = Value
    end
end

local function ApplyBrightness()
    Brightness = math.clamp(math.floor(Brightness), 0, 100)

    local MaxRobloxBrightness = 10
    Lighting.Brightness = (Brightness / 100) * MaxRobloxBrightness

    BrightnessLabel.Text = "ĐỘ SÁNG: " .. Brightness .. "%"
    BrightnessInput.Text = tostring(Brightness)
end

local function ToggleFreecam()
    Active = not Active

    if Active then
        Status.Text = "TRẠNG THÁI: BẬT"
        Status.BackgroundColor3 = Color3.fromRGB(16, 128, 55)

        SavedType = Camera.CameraType
        SavedSubject = Camera.CameraSubject
        CamPosition = Camera.CFrame.Position

        local X, Y, Z = Camera.CFrame:ToOrientation()
        RotationX = Y
        RotationY = X

        Camera.CameraType = Enum.CameraType.Scriptable

        SetAnchor(true)
        SetJumpVisible(false)
        UpDown.Visible = true
    else
        Status.Text = "TRẠNG THÁI: TẮT"
        Status.BackgroundColor3 = Color3.fromRGB(30, 30, 30)

        Camera.CameraType = SavedType or Enum.CameraType.Custom
        Camera.CameraSubject = SavedSubject

        SetAnchor(false)

        Up = false
        Down = false
        UpDown.Visible = false

        SetJumpVisible(true)
    end
end

