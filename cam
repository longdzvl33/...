local function UpdateHiddenState()
    Main.Visible = not Hidden
    ShowCircle.Visible = Hidden

    if Active then
        UpDown.Visible = true
        SetJumpVisible(false)
    else
        UpDown.Visible = false
        SetJumpVisible(true)
    end
end

local function ToggleMenu()
    Hidden = not Hidden
    UpdateHiddenState()
end

