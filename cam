local function SetColorFromMouse(InputPosition)
    local X = math.clamp(
        InputPosition.X - ColorSquare.AbsolutePosition.X,
        0,
        ColorSquare.AbsoluteSize.X
    )

    local Y = math.clamp(
        InputPosition.Y - ColorSquare.AbsolutePosition.Y,
        0,
        ColorSquare.AbsoluteSize.Y
    )

    Saturation = X / ColorSquare.AbsoluteSize.X
    Value = 1 - (Y / ColorSquare.AbsoluteSize.Y)

    UpdatePicker()
end

local function SetHueFromMouse(InputPosition)
    local Y = math.clamp(
        InputPosition.Y - HueBar.AbsolutePosition.Y,
        0,
        HueBar.AbsoluteSize.Y
    )

    Hue = 1 - (Y / HueBar.AbsoluteSize.Y)

    UpdatePicker()
end

local function SetNameColorFromMouse(InputPosition)
    local X = math.clamp(
        InputPosition.X - NameColorSquare.AbsolutePosition.X,
        0,
        NameColorSquare.AbsoluteSize.X
    )

    local Y = math.clamp(
        InputPosition.Y - NameColorSquare.AbsolutePosition.Y,
        0,
        NameColorSquare.AbsoluteSize.Y
    )

    NameSaturation = X / NameColorSquare.AbsoluteSize.X
    NameValue = 1 - (Y / NameColorSquare.AbsoluteSize.Y)

    UpdateNamePicker()
end

local function SetNameHueFromMouse(InputPosition)
    local Y = math.clamp(
        InputPosition.Y - NameHueBar.AbsolutePosition.Y,
        0,
        NameHueBar.AbsoluteSize.Y
    )

    NameHue = 1 - (Y / NameHueBar.AbsoluteSize.Y)

    UpdateNamePicker()
end

